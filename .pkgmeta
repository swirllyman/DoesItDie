package-as: DoesItDie

# Uploaded as each release's changelog on CurseForge (instead of the commit list).
manual-changelog:
    filename: CHANGELOG.md
    markup-type: markdown

# The addon lives in a subfolder; lift it to the zip root.
move-folders:
    DoesItDie/DoesItDie: DoesItDie

# Dev-only folders stay out of the release zip.
ignore:
    - WillItDieProbe
    - tools
    - README.md
    - CLAUDE.md
    - API.md
